{
    "name": "bryntum-showcases",
    "description": "Realistic, fully front-end Bryntum use cases built on the public npm packages",
    "private": true,
    "type": "module",
    "license": "MIT",
    "author": {
        "name": "Bryntum",
        "url": "https://bryntum.com",
        "email": "info@bryntum.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bryntum/showcases.git"
    },
    "homepage": "https://showcase.bryntum.com/",
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    },
    "workspaces": [
        "shared",
        "ev-operations",
        "logistics-control-tower",
        "offshore-wind-dispatch"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview --base /showcases/",
        "lint": "eslint . && stylelint \"**/*.css\"",
        "test": "playwright test",
        "screenshots": "node scripts/screenshots.js"
    },
    "dependencies": {
        "@bryntum/core-enterprise": "8.0.0",
        "@bryntum/engine-enterprise": "8.0.0",
        "@bryntum/gantt-enterprise": "8.0.0",
        "@bryntum/grid-enterprise": "8.0.0",
        "@bryntum/scheduler-enterprise": "8.0.0",
        "@fontsource-variable/montserrat": "^5.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "1.65.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "eslint": "^10.14.0",
        "globals": "^17.14.0",
        "stylelint": "18.0.0",
        "stylelint-config-recommended": "19.0.0",
        "vite": "^8.3.6"
    },
    "overrides": {
        "minimatch": "^11.0.1"
    }
}
